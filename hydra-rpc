#!/usr/bin/env python3
"""hydra-rpc: report Windows games (Wine/Proton/umu) to Discord (via arRPC) as Rich Presence.

Scans /proc for Windows executables running under any Wine/Proton runtime, maps them
to their Discord application id using Discord's detectable-applications database,
and pushes a "Playing <Game>" activity to arRPC's IPC socket so it shows up in
Vesktop / any client connected to arRPC.
"""

import argparse
import json
import math
import os
import signal
import socket
import struct
import sys
import time
import urllib.request

CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "hydra-rpc"
)
CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "hydra-rpc"
)
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
DB_CACHE = os.path.join(CACHE_DIR, "detectable.json")
SESSION_CACHE = os.path.join(CACHE_DIR, "sessions.json")

DB_URL = "https://discord.com/api/v9/applications/detectable"
SOCKET_CONNECT_TIMEOUT = 1
RETRY_INITIAL_SECONDS = 1
RETRY_MAX_SECONDS = 60
DEFAULT_SOCKET_ATTEMPTS = 3
MAX_SOCKET_PATHS = 10
DEFAULT_MAX_ACTIVITIES = 0
MAX_ACTIVITIES = 10
LOG_LEVELS = {"debug": 10, "info": 20, "warning": 30, "error": 40}
CURRENT_LOG_LEVEL = LOG_LEVELS["info"]
LOG_FILE_HANDLE = None

# Discords IPC framing: [type:int32][length:int32][json bytes]
IPC_HANDSHAKE = 0
IPC_FRAME = 1

# Windows processes we should never report as "games".
DEFAULT_BLOCKLIST = {
    "wineserver",
    "winedevice.exe",
    "services.exe",
    "plugplay.exe",
    "explorer.exe",
    "svchost.exe",
    "rundll32.exe",
    "start.exe",
    "wineboot.exe",
    "winecfg.exe",
    "control.exe",
    "taskmgr.exe",
    "regedit.exe",
    "uninstaller.exe",
    "iexplore.exe",
    "notepad.exe",
    "cmd.exe",
    "conhost.exe",
    "rpcss.exe",
    "wininit.exe",
    "winlogon.exe",
    "csrss.exe",
    "umu.exe",
}

DEFAULT_CONFIG = {
    "poll_seconds": 5,
    "activity_refresh_seconds": 60,
    "db_url": DB_URL,
    "db_ttl_seconds": 7 * 24 * 3600,
    "socket_dir": "",
    "socket_path": "",
    "max_socket_attempts": DEFAULT_SOCKET_ATTEMPTS,
    "max_activities": DEFAULT_MAX_ACTIVITIES,
    "blocklist_ids": [],
    "blocklist_names": [],
    "activity_template": "{game_name}",
    "rich_activity": {},
    "log_file": "",
    "log_level": "info",
    "blocklist": sorted(DEFAULT_BLOCKLIST),
    "overrides": {},
}


def log(msg, level="info"):
    if LOG_LEVELS.get(level, LOG_LEVELS["info"]) < CURRENT_LOG_LEVEL:
        return
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}"
    print(line, flush=True)
    if LOG_FILE_HANDLE is not None:
        try:
            LOG_FILE_HANDLE.write(line + "\n")
            LOG_FILE_HANDLE.flush()
        except OSError:
            pass


def configure_logging(cfg):
    global CURRENT_LOG_LEVEL, LOG_FILE_HANDLE
    CURRENT_LOG_LEVEL = LOG_LEVELS[cfg["log_level"]]
    path = cfg.get("log_file", "")
    if not path:
        return
    path = os.path.expanduser(os.path.expandvars(path))
    try:
        parent = os.path.dirname(path)
        if parent:
            os.makedirs(parent, exist_ok=True)
        LOG_FILE_HANDLE = open(path, "a", buffering=1)
    except OSError as e:
        LOG_FILE_HANDLE = None
        log(f"could not open log_file '{path}': {e}", "warning")


def close_logging():
    global LOG_FILE_HANDLE
    if LOG_FILE_HANDLE is not None:
        try:
            LOG_FILE_HANDLE.close()
        except OSError:
            pass
        LOG_FILE_HANDLE = None


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    if os.path.exists(CONFIG_PATH):
        try:
            with open(CONFIG_PATH, "r") as f:
                user = json.load(f)
            if not isinstance(user, dict):
                raise ValueError("top-level config must be an object")
            cfg.update(user)
        except Exception as e:
            log(f"could not read config ({e}); using defaults", "warning")

    def normalise_number(key, minimum):
        default = DEFAULT_CONFIG[key]
        try:
            value = float(cfg.get(key, default))
            if not math.isfinite(value) or value < minimum:
                raise ValueError
            cfg[key] = int(value) if value.is_integer() else value
        except (TypeError, ValueError):
            log(f"invalid {key}; using {default}", "warning")
            cfg[key] = default

    def normalise_integer(key, minimum, maximum):
        default = DEFAULT_CONFIG[key]
        try:
            raw = cfg.get(key, default)
            if isinstance(raw, bool):
                raise ValueError
            value = float(raw)
            if not math.isfinite(value) or value != int(value):
                raise ValueError
            value = int(value)
            if value < minimum or value > maximum:
                raise ValueError
            cfg[key] = value
        except (TypeError, ValueError, OverflowError):
            log(f"invalid {key}; using {default}", "warning")
            cfg[key] = default

    normalise_number("poll_seconds", 0.1)
    normalise_number("activity_refresh_seconds", 1)
    normalise_number("db_ttl_seconds", 0)
    normalise_integer("max_socket_attempts", 1, MAX_SOCKET_PATHS)
    normalise_integer("max_activities", 0, MAX_ACTIVITIES)

    if not isinstance(cfg.get("db_url"), str) or not cfg["db_url"].strip():
        log("invalid db_url; using the Discord detectable-applications endpoint", "warning")
        cfg["db_url"] = DB_URL

    for key in ("socket_dir", "socket_path", "log_file"):
        if not isinstance(cfg.get(key), str):
            log(f"invalid {key}; using the default", "warning")
            cfg[key] = ""

    if not isinstance(cfg.get("activity_template"), str) or not cfg["activity_template"]:
        log("invalid activity_template; using the game name", "warning")
        cfg["activity_template"] = DEFAULT_CONFIG["activity_template"]

    if not isinstance(cfg.get("rich_activity"), dict):
        log("invalid rich_activity; ignoring it", "warning")
        cfg["rich_activity"] = {}

    log_level = str(cfg.get("log_level", "info")).lower()
    if log_level not in LOG_LEVELS:
        log("invalid log_level; using info", "warning")
        log_level = "info"
    cfg["log_level"] = log_level

    def normalise_string_set(key, casefold=False):
        raw = cfg.get(key, [])
        if not isinstance(raw, (list, tuple, set)):
            log(f"invalid {key}; using an empty list", "warning")
            cfg[key] = set()
            return
        values = {str(x).strip() for x in raw if str(x).strip()}
        cfg[key] = {x.casefold() for x in values} if casefold else values

    normalise_string_set("blocklist_ids")
    normalise_string_set("blocklist_names", casefold=True)

    raw_blocklist = cfg.get("blocklist", [])
    if isinstance(raw_blocklist, (list, tuple, set)):
        cfg["blocklist"] = {str(x).lower() for x in raw_blocklist if str(x)}
    else:
        log("invalid blocklist; using defaults", "warning")
        cfg["blocklist"] = set(DEFAULT_BLOCKLIST)

    overrides = {}
    raw_overrides = cfg.get("overrides") or {}
    if not isinstance(raw_overrides, dict):
        log("invalid overrides; ignoring them", "warning")
        raw_overrides = {}
    for exe, info in raw_overrides.items():
        if not isinstance(exe, str) or not exe.strip() or not isinstance(info, dict):
            log("ignoring malformed game override", "warning")
            continue
        app_id = info.get("id")
        name = info.get("name")
        if not app_id or not name:
            log(f"ignoring incomplete override for '{exe}'", "warning")
            continue
        overrides[exe.lower()] = (str(app_id), str(name))
    cfg["overrides"] = overrides
    return cfg


def ensure_config(cfg):
    if not os.path.exists(CONFIG_PATH):
        try:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            with open(CONFIG_PATH, "w") as f:
                json.dump(DEFAULT_CONFIG, f, indent=2)
        except Exception as e:
            log(f"could not write default config ({e})", "warning")


def download_db(url):
    req = urllib.request.Request(url, headers={"User-Agent": "hydra-rpc/1.0"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read().decode("utf-8"))


def build_index(db):
    index = {}
    for game in db:
        gid = str(game.get("id", ""))
        gname = game.get("name", "Unknown Game")
        for exe in game.get("executables", []):
            if exe.get("is_launcher"):
                continue
            name = exe.get("name", "")
            if not name:
                continue
            name = name.replace("\\", "/").lstrip(">").strip()
            base = name.rsplit("/", 1)[-1].lower()
            if base and base not in index:
                index[base] = (gid, gname)
    return index


def load_db(cfg):
    cached = None
    if os.path.exists(DB_CACHE):
        try:
            age = time.time() - os.path.getmtime(DB_CACHE)
            if age < cfg["db_ttl_seconds"]:
                with open(DB_CACHE, "r") as f:
                    cached = json.load(f)
        except Exception as e:
            log(f"failed to load cached db ({e})", "warning")

    if cached is None:
        try:
            log("downloading detectable applications database...")
            db = download_db(cfg["db_url"])
            os.makedirs(CACHE_DIR, exist_ok=True)
            tmp = DB_CACHE + ".tmp"
            with open(tmp, "w") as f:
                json.dump(db, f)
            os.replace(tmp, DB_CACHE)
            log(f"cached {len(db)} detectable applications")
            cached = db
        except Exception as e:
            log(f"could not download db ({e})", "warning")
            if os.path.exists(DB_CACHE):
                with open(DB_CACHE, "r") as f:
                    cached = json.load(f)

    return build_index(cached) if cached else {}


def load_sessions():
    if not os.path.exists(SESSION_CACHE):
        return {}
    try:
        with open(SESSION_CACHE, "r") as f:
            sessions = json.load(f)
        return sessions if isinstance(sessions, dict) else {}
    except (OSError, ValueError) as e:
        log(f"could not read session cache ({e})", "warning")
        return {}


def save_sessions(sessions):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = SESSION_CACHE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(sessions, f, indent=2, sort_keys=True)
        os.replace(tmp, SESSION_CACHE)
    except OSError as e:
        log(f"could not save session cache ({e})", "warning")


def runtime_dir(cfg):
    d = cfg.get("socket_dir") or os.environ.get("XDG_RUNTIME_DIR")
    if d:
        return os.path.expanduser(os.path.expandvars(d))
    return f"/run/user/{os.getuid()}"


def encode_frame(msg_type, obj):
    data = json.dumps(obj).encode("utf-8")
    return struct.pack("<II", msg_type, len(data)) + data


def read_exact(sock, n):
    chunks = []
    got = 0
    while got < n:
        chunk = sock.recv(n - got)
        if not chunk:
            raise ConnectionError("socket closed")
        chunks.append(chunk)
        got += len(chunk)
    return b"".join(chunks)


def read_frame(sock, timeout):
    sock.settimeout(timeout)
    try:
        header = read_exact(sock, 8)
    except (socket.timeout, ConnectionError, OSError):
        return None
    msg_type, size = struct.unpack("<II", header)
    try:
        data = read_exact(sock, size)
    except (socket.timeout, ConnectionError, OSError):
        return None
    try:
        return msg_type, json.loads(data.decode("utf-8"))
    except Exception:
        return msg_type, None


class RPCClient:
    def __init__(self, base, socket_path="", max_socket_attempts=DEFAULT_SOCKET_ATTEMPTS):
        self.base = base
        socket_path = str(socket_path or "")
        self.socket_path = os.path.expanduser(os.path.expandvars(socket_path))
        self.max_socket_attempts = max(
            1, min(MAX_SOCKET_PATHS, int(max_socket_attempts))
        )
        self.path = None
        self.last_path = None
        self.sock = None
        self.client_id = None
        self.nonce = 0

    def _connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(SOCKET_CONNECT_TIMEOUT)
        try:
            s.connect(self.path)
            return s
        except OSError:
            s.close()
            raise

    def candidate_paths(self):
        if self.socket_path:
            return [self.socket_path]

        paths = []
        if self.last_path:
            paths.append(self.last_path)
        for i in range(self.max_socket_attempts):
            if len(paths) >= self.max_socket_attempts:
                break
            path = f"{self.base}-{i}"
            if path not in paths:
                paths.append(path)
        return paths

    def connect(self, client_id):
        if self.sock is not None:
            self.close()
        last_error = None
        for path in self.candidate_paths():
            self.path = path
            try:
                self.sock = self._connect()
                self.last_path = path
                break
            except OSError as e:
                last_error = e
                self.sock = None
        if self.sock is None:
            self.path = self.socket_path or None
            raise last_error or OSError(f"no arRPC socket found under {self.base}")
        self.sock.sendall(encode_frame(IPC_HANDSHAKE, {"v": 1, "client_id": client_id}))
        read_frame(self.sock, 2)  # drain READY
        self.client_id = client_id

    def send(self, cmd, args):
        self.nonce += 1
        self.sock.sendall(
            encode_frame(IPC_FRAME, {"cmd": cmd, "args": args, "nonce": str(self.nonce)})
        )
        read_frame(self.sock, 1)  # drain ack

    def close(self):
        if self.sock is not None:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock = None
        self.client_id = None


RESERVED_ACTIVITY_FIELDS = {"application_id", "name", "timestamps", "type"}


class TemplateValues(dict):
    def __missing__(self, key):
        return "{" + key + "}"


def render_text(value, values):
    if not isinstance(value, str):
        return value
    try:
        return value.format_map(TemplateValues(values))
    except (KeyError, ValueError):
        return value


def render_activity_value(value, values):
    if isinstance(value, str):
        return render_text(value, values)
    if isinstance(value, list):
        return [render_activity_value(item, values) for item in value]
    if isinstance(value, dict):
        return {key: render_activity_value(item, values) for key, item in value.items()}
    return value


def resolve_game(exe, info, overrides, index, cfg):
    app = overrides.get(exe) or index.get(exe)
    if not app:
        return None

    app_id, game_name = app
    game_name_key = game_name.casefold()
    if app_id in cfg["blocklist_ids"] or game_name_key in cfg["blocklist_names"]:
        return None

    if isinstance(info, dict):
        pid = info["pid"]
    else:
        pid = info
    values = {
        "game_name": game_name,
        "exe": exe,
        "app_id": app_id,
    }
    activity = {
        "application_id": app_id,
        "name": render_text(cfg["activity_template"], values),
    }
    rich_activity = render_activity_value(cfg["rich_activity"], values)
    for key, value in rich_activity.items():
        if key not in RESERVED_ACTIVITY_FIELDS:
            activity[key] = value

    return {
        "exe": exe,
        "app_id": app_id,
        "game_name": game_name,
        "display_name": activity["name"],
        "pid": pid,
        "activity": activity,
    }


def choose_games(exes, active, overrides, index, cfg):
    candidates = [exe for exe in active if exe in exes]
    candidates.extend(exe for exe in sorted(exes) if exe not in candidates)
    games = []
    for exe in candidates:
        game = resolve_game(exe, exes[exe], overrides, index, cfg)
        if game:
            games.append(game)
            if cfg["max_activities"] and len(games) >= cfg["max_activities"]:
                break
    return games


def choose_game(exes, active, overrides, index):
    cfg = dict(DEFAULT_CONFIG)
    cfg["blocklist_ids"] = set()
    cfg["blocklist_names"] = set()
    cfg["rich_activity"] = {}
    game = choose_games(exes, [active] if active else [], overrides, index, cfg)
    if not game:
        return None
    selected = game[0]
    return selected["exe"], selected["app_id"], selected["display_name"], selected["pid"]


def activity_due(last_sent, now, interval):
    return last_sent is None or now - last_sent >= interval


def retry_delay(failures):
    if failures <= 0:
        return 0
    return min(RETRY_MAX_SECONDS, RETRY_INITIAL_SECONDS * 2 ** (failures - 1))


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        description="Report Wine/Proton games to Discord through arRPC."
    )
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument(
        "--dry-run",
        action="store_true",
        help="detect and log games without sending Discord activity",
    )
    modes.add_argument(
        "--validate-config",
        action="store_true",
        help="validate settings, load the game database, and check arRPC",
    )
    return parser.parse_args(argv)


def validate_config(cfg, index):
    base = runtime_dir(cfg) + "/discord-ipc"
    client = RPCClient(
        base,
        cfg.get("socket_path", ""),
        cfg["max_socket_attempts"],
    )
    for path in client.candidate_paths():
        client.path = path
        try:
            probe = client._connect()
            probe.close()
            log(f"config valid; loaded {len(index)} executable mappings")
            log(f"arRPC socket ready: {path}")
            return True
        except OSError:
            continue
    log(
        f"config valid; loaded {len(index)} executable mappings, "
        "but no arRPC socket was found",
        "warning",
    )
    return False


def close_state(state):
    client = state["client"]
    if client.sock is not None:
        try:
            client.send("SET_ACTIVITY", {"activity": None, "pid": 0})
        except OSError:
            pass
    client.close()


def session_start(sessions, game):
    record = sessions.get(game["exe"])
    now_ms = int(time.time() * 1000)
    if isinstance(record, dict):
        try:
            start_ms = int(record["start_ms"])
            if int(record["pid"]) == game["pid"] and 0 < start_ms <= now_ms:
                return start_ms
        except (KeyError, TypeError, ValueError):
            pass
    return now_ms


def detect_exes(blocklist):
    found = {}
    try:
        pids = os.listdir("/proc")
    except OSError:
        return found
    for pid in pids:
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                raw = f.read()
        except OSError:
            continue
        if not raw:
            continue
        parts = raw.split(b"\0")
        for part in parts:
            part = part.rstrip()
            if len(part) < 4 or part[-4:].lower() != b".exe":
                continue
            arg = part.decode("utf-8", "ignore")
            base = arg.replace("\\", "/").rsplit("/", 1)[-1].lower()
            if not base or base in blocklist:
                continue
            found.setdefault(base, {"pid": int(pid), "path": arg})
    return found


def main(argv=None):
    args = parse_args(argv)
    cfg = load_config()
    configure_logging(cfg)
    ensure_config(cfg)
    index = load_db(cfg)
    if not index:
        log("no detectable database available; games will need overrides", "error")
    log(f"loaded {len(index)} executable mappings")

    if args.validate_config:
        valid = validate_config(cfg, index)
        close_logging()
        return 0 if valid else 1

    sessions = load_sessions()
    base = runtime_dir(cfg) + "/discord-ipc"
    states = {}
    sessions_dirty = False
    dry_signature = None
    seen_unknown = set()

    def stop(*_args):
        log("shutting down")
        for state in states.values():
            close_state(state)
        save_sessions(sessions)
        close_logging()
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    while True:
        try:
            exes = detect_exes(cfg["blocklist"])
            for exe in sorted(exes):
                if not (cfg["overrides"].get(exe) or index.get(exe)) and exe not in seen_unknown:
                    seen_unknown.add(exe)
                    log(f"unrecognized executable '{exe}' (add an override in {CONFIG_PATH})", "warning")

            games = choose_games(exes, states.keys(), cfg["overrides"], index, cfg)

            if args.dry_run:
                signature = tuple(
                    (game["exe"], game["display_name"])
                    for game in games
                )
                if signature != dry_signature:
                    if games:
                        for game in games:
                            log(
                                f"dry-run: detected game: {game['display_name']} "
                                f"({game['exe']}) (would report)"
                            )
                    else:
                        log("dry-run: no supported games detected")
                    dry_signature = signature
                time.sleep(cfg["poll_seconds"])
                continue

            selected = {game["exe"]: game for game in games}
            for exe in list(states):
                if exe not in selected:
                    log(f"game exited: {states[exe]['display_name']}; clearing presence")
                    close_state(states.pop(exe))
                    if sessions.pop(exe, None) is not None:
                        sessions_dirty = True

            for exe, game in selected.items():
                state = states.get(exe)
                if state is None:
                    start_ms = session_start(sessions, game)
                    previous_session = sessions.get(exe)
                    sessions[exe] = {"start_ms": start_ms, "pid": game["pid"]}
                    sessions_dirty |= previous_session != sessions[exe]
                    state = {
                        **game,
                        "start_ms": start_ms,
                        "client": RPCClient(
                            base,
                            cfg.get("socket_path", ""),
                            cfg["max_socket_attempts"],
                        ),
                        "last_activity_sent": None,
                        "connection_failures": 0,
                        "next_connection_attempt": 0.0,
                    }
                    states[exe] = state
                    log(
                        f"detected game: {game['display_name']} ({exe}) "
                        f"app_id={game['app_id']}"
                    )
                else:
                    metadata_changed = any(
                        state[key] != game[key]
                        for key in ("app_id", "display_name", "activity")
                    )
                    state.update(game)
                    if metadata_changed:
                        state["client"].close()
                        state["last_activity_sent"] = None
                        state["connection_failures"] = 0
                        state["next_connection_attempt"] = 0.0

                now = time.monotonic()
                if state["client"].sock is None:
                    if now < state["next_connection_attempt"]:
                        continue
                    try:
                        state["client"].connect(state["app_id"])
                    except OSError as e:
                        state["connection_failures"] += 1
                        delay = retry_delay(state["connection_failures"])
                        state["next_connection_attempt"] = time.monotonic() + delay
                        target = state["client"].path or f"{base}-0..{cfg['max_socket_attempts'] - 1}"
                        log(
                            f"could not connect to arRPC at {target} ({e}); "
                            f"retrying in {delay}s",
                            "warning",
                        )
                        continue
                    state["connection_failures"] = 0
                    state["next_connection_attempt"] = 0.0
                    state["last_activity_sent"] = None

                now = time.monotonic()
                if activity_due(
                    state["last_activity_sent"],
                    now,
                    cfg["activity_refresh_seconds"],
                ):
                    activity = dict(state["activity"])
                    activity["timestamps"] = {"start": state["start_ms"]}
                    try:
                        state["client"].send(
                            "SET_ACTIVITY",
                            {"activity": activity, "pid": state["pid"]},
                        )
                        state["last_activity_sent"] = now
                    except OSError:
                        log("arRPC connection lost, will reconnect", "warning")
                        state["client"].close()
                        state["connection_failures"] += 1
                        delay = retry_delay(state["connection_failures"])
                        state["next_connection_attempt"] = time.monotonic() + delay

            if sessions_dirty:
                save_sessions(sessions)
                sessions_dirty = False
            time.sleep(cfg["poll_seconds"])

        except Exception as e:
            log(f"unexpected error: {e}", "error")
            time.sleep(cfg["poll_seconds"])


if __name__ == "__main__":
    raise SystemExit(main())
