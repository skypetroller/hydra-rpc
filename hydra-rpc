#!/usr/bin/env python3
"""hydra-rpc: report Windows games (Wine/Proton/umu) to Discord (via arRPC) as Rich Presence.

Scans /proc for Windows executables running under any Wine/Proton runtime, maps them
to their Discord application id using Discord's detectable-applications database,
and pushes a "Playing <Game>" activity to arRPC's IPC socket so it shows up in
Vesktop / any client connected to arRPC.
"""

import json
import math
import os
import signal
import socket
import struct
import sys
import time
import urllib.request

CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "hydra-rpc"
)
CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "hydra-rpc"
)
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
DB_CACHE = os.path.join(CACHE_DIR, "detectable.json")

DB_URL = "https://discord.com/api/v9/applications/detectable"

# Discords IPC framing: [type:int32][length:int32][json bytes]
IPC_HANDSHAKE = 0
IPC_FRAME = 1

# Windows processes we should never report as "games".
DEFAULT_BLOCKLIST = {
    "wineserver",
    "winedevice.exe",
    "services.exe",
    "plugplay.exe",
    "explorer.exe",
    "svchost.exe",
    "rundll32.exe",
    "start.exe",
    "wineboot.exe",
    "winecfg.exe",
    "control.exe",
    "taskmgr.exe",
    "regedit.exe",
    "uninstaller.exe",
    "iexplore.exe",
    "notepad.exe",
    "cmd.exe",
    "conhost.exe",
    "rpcss.exe",
    "wininit.exe",
    "winlogon.exe",
    "csrss.exe",
    "umu.exe",
}

DEFAULT_CONFIG = {
    "poll_seconds": 5,
    "activity_refresh_seconds": 60,
    "db_url": DB_URL,
    "db_ttl_seconds": 7 * 24 * 3600,
    "socket_dir": "",
    "socket_path": "",
    "blocklist": sorted(DEFAULT_BLOCKLIST),
    "overrides": {},
}


def log(msg):
    print(time.strftime("%Y-%m-%d %H:%M:%S"), msg, flush=True)


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    if os.path.exists(CONFIG_PATH):
        try:
            with open(CONFIG_PATH, "r") as f:
                user = json.load(f)
            if not isinstance(user, dict):
                raise ValueError("top-level config must be an object")
            cfg.update(user)
        except Exception as e:
            log(f"warning: could not read config ({e}); using defaults")

    def normalise_number(key, minimum):
        default = DEFAULT_CONFIG[key]
        try:
            value = float(cfg.get(key, default))
            if not math.isfinite(value) or value < minimum:
                raise ValueError
            cfg[key] = int(value) if value.is_integer() else value
        except (TypeError, ValueError):
            log(f"warning: invalid {key}; using {default}")
            cfg[key] = default

    normalise_number("poll_seconds", 0.1)
    normalise_number("activity_refresh_seconds", 1)
    normalise_number("db_ttl_seconds", 0)

    if not isinstance(cfg.get("db_url"), str) or not cfg["db_url"].strip():
        log("warning: invalid db_url; using the Discord detectable-applications endpoint")
        cfg["db_url"] = DB_URL

    for key in ("socket_dir", "socket_path"):
        if not isinstance(cfg.get(key), str):
            log(f"warning: invalid {key}; using automatic discovery")
            cfg[key] = ""

    raw_blocklist = cfg.get("blocklist", [])
    if isinstance(raw_blocklist, (list, tuple, set)):
        cfg["blocklist"] = {str(x).lower() for x in raw_blocklist if str(x)}
    else:
        log("warning: invalid blocklist; using defaults")
        cfg["blocklist"] = set(DEFAULT_BLOCKLIST)

    overrides = {}
    raw_overrides = cfg.get("overrides") or {}
    if not isinstance(raw_overrides, dict):
        log("warning: invalid overrides; ignoring them")
        raw_overrides = {}
    for exe, info in raw_overrides.items():
        if not isinstance(exe, str) or not exe.strip() or not isinstance(info, dict):
            log("warning: ignoring malformed game override")
            continue
        app_id = info.get("id")
        name = info.get("name")
        if not app_id or not name:
            log(f"warning: ignoring incomplete override for '{exe}'")
            continue
        overrides[exe.lower()] = (str(app_id), str(name))
    cfg["overrides"] = overrides
    return cfg


def ensure_config(cfg):
    if not os.path.exists(CONFIG_PATH):
        try:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            with open(CONFIG_PATH, "w") as f:
                json.dump(DEFAULT_CONFIG, f, indent=2)
        except Exception as e:
            log(f"warning: could not write default config ({e})")


def download_db(url):
    req = urllib.request.Request(url, headers={"User-Agent": "hydra-rpc/1.0"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read().decode("utf-8"))


def build_index(db):
    index = {}
    for game in db:
        gid = str(game.get("id", ""))
        gname = game.get("name", "Unknown Game")
        for exe in game.get("executables", []):
            if exe.get("is_launcher"):
                continue
            name = exe.get("name", "")
            if not name:
                continue
            name = name.replace("\\", "/").lstrip(">").strip()
            base = name.rsplit("/", 1)[-1].lower()
            if base and base not in index:
                index[base] = (gid, gname)
    return index


def load_db(cfg):
    cached = None
    if os.path.exists(DB_CACHE):
        try:
            age = time.time() - os.path.getmtime(DB_CACHE)
            if age < cfg["db_ttl_seconds"]:
                with open(DB_CACHE, "r") as f:
                    cached = json.load(f)
        except Exception as e:
            log(f"warning: failed to load cached db ({e})")

    if cached is None:
        try:
            log("downloading detectable applications database...")
            db = download_db(cfg["db_url"])
            os.makedirs(CACHE_DIR, exist_ok=True)
            tmp = DB_CACHE + ".tmp"
            with open(tmp, "w") as f:
                json.dump(db, f)
            os.replace(tmp, DB_CACHE)
            log(f"cached {len(db)} detectable applications")
            cached = db
        except Exception as e:
            log(f"warning: could not download db ({e})")
            if os.path.exists(DB_CACHE):
                with open(DB_CACHE, "r") as f:
                    cached = json.load(f)

    return build_index(cached) if cached else {}


def runtime_dir(cfg):
    d = cfg.get("socket_dir") or os.environ.get("XDG_RUNTIME_DIR")
    if d:
        return os.path.expanduser(os.path.expandvars(d))
    return f"/run/user/{os.getuid()}"


def encode_frame(msg_type, obj):
    data = json.dumps(obj).encode("utf-8")
    return struct.pack("<II", msg_type, len(data)) + data


def read_exact(sock, n):
    chunks = []
    got = 0
    while got < n:
        chunk = sock.recv(n - got)
        if not chunk:
            raise ConnectionError("socket closed")
        chunks.append(chunk)
        got += len(chunk)
    return b"".join(chunks)


def read_frame(sock, timeout):
    sock.settimeout(timeout)
    try:
        header = read_exact(sock, 8)
    except (socket.timeout, ConnectionError, OSError):
        return None
    msg_type, size = struct.unpack("<II", header)
    try:
        data = read_exact(sock, size)
    except (socket.timeout, ConnectionError, OSError):
        return None
    try:
        return msg_type, json.loads(data.decode("utf-8"))
    except Exception:
        return msg_type, None


class RPCClient:
    def __init__(self, base, socket_path=""):
        self.base = base
        socket_path = str(socket_path or "")
        self.socket_path = os.path.expanduser(os.path.expandvars(socket_path))
        self.path = None
        self.sock = None
        self.client_id = None
        self.nonce = 0

    def _connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(5)
        try:
            s.connect(self.path)
            return s
        except OSError:
            s.close()
            raise

    def connect(self, client_id):
        if self.sock is not None:
            self.close()
        paths = [self.socket_path] if self.socket_path else [
            f"{self.base}-{i}" for i in range(10)
        ]
        last_error = None
        for path in paths:
            self.path = path
            try:
                self.sock = self._connect()
                break
            except OSError as e:
                last_error = e
                self.sock = None
        if self.sock is None:
            self.path = self.socket_path or None
            raise last_error or OSError("no arRPC socket found")
        self.sock.sendall(encode_frame(IPC_HANDSHAKE, {"v": 1, "client_id": client_id}))
        read_frame(self.sock, 2)  # drain READY
        self.client_id = client_id

    def send(self, cmd, args):
        self.nonce += 1
        self.sock.sendall(
            encode_frame(IPC_FRAME, {"cmd": cmd, "args": args, "nonce": str(self.nonce)})
        )
        read_frame(self.sock, 1)  # drain ack

    def close(self):
        if self.sock is not None:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock = None
        self.client_id = None


def choose_game(exes, active, overrides, index):
    candidates = sorted(exes)
    if active in exes:
        candidates.remove(active)
        candidates.insert(0, active)

    for exe in candidates:
        app = overrides.get(exe) or index.get(exe)
        if app:
            return exe, app[0], app[1], exes[exe]
    return None


def activity_due(last_sent, now, interval):
    return last_sent is None or now - last_sent >= interval


def detect_exes(blocklist):
    found = {}
    try:
        pids = os.listdir("/proc")
    except OSError:
        return found
    for pid in pids:
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                raw = f.read()
        except OSError:
            continue
        if not raw:
            continue
        parts = raw.split(b"\0")
        for part in parts:
            part = part.rstrip()
            if len(part) < 4 or part[-4:].lower() != b".exe":
                continue
            arg = part.decode("utf-8", "ignore")
            base = arg.replace("\\", "/").rsplit("/", 1)[-1].lower()
            if not base or base in blocklist:
                continue
            if base not in found:
                found[base] = int(pid)
    return found


def main():
    cfg = load_config()
    ensure_config(cfg)
    index = load_db(cfg)
    if not index:
        log("error: no detectable database available; cannot map games")
    log(f"loaded {len(index)} executable mappings")

    base = runtime_dir(cfg) + "/discord-ipc"
    client = RPCClient(base, cfg.get("socket_path", ""))

    active = None
    start_ms = None
    last_activity_sent = None

    def clear_presence():
        nonlocal active, start_ms, last_activity_sent
        if client.sock is not None:
            try:
                client.send("SET_ACTIVITY", {"activity": None, "pid": 0})
            except OSError:
                pass
        client.close()
        active = None
        start_ms = None
        last_activity_sent = None

    def stop(*_args):
        log("shutting down")
        clear_presence()
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    warned_no_socket = False
    seen_unknown = set()
    while True:
        try:
            exes = detect_exes(cfg["blocklist"])

            for exe in sorted(exes):
                if not (cfg["overrides"].get(exe) or index.get(exe)) and exe not in seen_unknown:
                    seen_unknown.add(exe)
                    log(f"unrecognized executable '{exe}' (add an override in {CONFIG_PATH})")

            chosen = choose_game(exes, active, cfg["overrides"], index)

            if chosen is None:
                if active is not None:
                    log("game exited, clearing presence")
                    clear_presence()
                if client.sock is None and not warned_no_socket:
                    warned_no_socket = True
                time.sleep(cfg["poll_seconds"])
                continue

            warned_no_socket = False
            exe, app_id, name, pid = chosen

            if active != exe:
                log(f"detected game: {name} ({exe}) app_id={app_id}")
                try:
                    client.connect(app_id)
                except OSError as e:
                    target = client.path or f"{base}-0..9"
                    log(f"could not connect to arRPC at {target} ({e}); is arRPC running?")
                    if active is not None:
                        clear_presence()
                    time.sleep(cfg["poll_seconds"])
                    continue
                active = exe
                start_ms = int(time.time() * 1000)
                last_activity_sent = None

            # arRPC retains the activity; refresh periodically to detect a dead connection.
            now = time.monotonic()
            if activity_due(last_activity_sent, now, cfg["activity_refresh_seconds"]):
                activity = {
                    "application_id": app_id,
                    "name": name,
                    "timestamps": {"start": start_ms},
                }
                try:
                    client.send("SET_ACTIVITY", {"activity": activity, "pid": pid})
                    last_activity_sent = now
                except OSError:
                    log("arRPC connection lost, will reconnect")
                    active = None
                    last_activity_sent = None
                    client.close()

            time.sleep(cfg["poll_seconds"])

        except Exception as e:
            log(f"unexpected error: {e}")
            time.sleep(cfg["poll_seconds"])


if __name__ == "__main__":
    main()
