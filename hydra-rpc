def download_db(url):
    req = urllib.request.Request(url, headers={"User-Agent": "hydra-rpc/1.0"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read().decode("utf-8"))


def build_index(db):
    index = {}
    for game in db:
        gid = str(game.get("id", ""))
        gname = game.get("name", "Unknown Game")
        for exe in game.get("executables", []):
            if exe.get("is_launcher"):
                continue
            name = exe.get("name", "")
            if not name:
                continue
            name = name.replace("\\", "/").lstrip(">").strip()
            base = name.rsplit("/", 1)[-1].lower()
            if base and base not in index:
                index[base] = (gid, gname)
    return index


def load_db(cfg):
    cached = None
    if os.path.exists(DB_CACHE):
        try:
            age = time.time() - os.path.getmtime(DB_CACHE)
            if age < cfg["db_ttl_seconds"]:
                with open(DB_CACHE, "r") as f:
                    cached = json.load(f)
        except Exception as e:
            log(f"failed to load cached db ({e})", "warning")

    if cached is None:
        try:
            log("downloading detectable applications database...")
            db = download_db(cfg["db_url"])
            os.makedirs(CACHE_DIR, exist_ok=True)
            tmp = DB_CACHE + ".tmp"
            with open(tmp, "w") as f:
                json.dump(db, f)
            os.replace(tmp, DB_CACHE)
            log(f"cached {len(db)} detectable applications")
            cached = db
        except Exception as e:
            log(f"could not download db ({e})", "warning")
            if os.path.exists(DB_CACHE):
                with open(DB_CACHE, "r") as f:
                    cached = json.load(f)

    return build_index(cached) if cached else {}


STALE_SESSION_MAX_AGE_MS = 7 * 24 * 3600 * 1000
MAX_SESSION_ENTRIES = 256


def prune_sessions(sessions, now_ms=None):
    # Drop malformed or ancient entries and cap the total count so the cache
    # file stays small even across crashes. Keeps the newest entries.
    if now_ms is None:
        now_ms = int(time.time() * 1000)
    valid = {}
    for exe, record in sessions.items():
        try:
            start_ms = int(record["start_ms"])
            int(record["pid"])
            int(record["start_tick"])
        except (KeyError, TypeError, ValueError, AttributeError):
            continue
        if 0 < start_ms <= now_ms and now_ms - start_ms <= STALE_SESSION_MAX_AGE_MS:
            valid[exe] = record
    if len(valid) > MAX_SESSION_ENTRIES:
        newest = sorted(valid, key=lambda exe: valid[exe]["start_ms"])[-MAX_SESSION_ENTRIES:]
        valid = {exe: valid[exe] for exe in newest}
    return valid


def load_sessions():
    if not os.path.exists(SESSION_CACHE):
        return {}
    try:
        with open(SESSION_CACHE, "r") as f:
            sessions = json.load(f)
        if not isinstance(sessions, dict):
            return {}
    except (OSError, ValueError) as e:
        log(f"could not read session cache ({e})", "warning")
        return {}
    return prune_sessions(sessions)


def save_sessions(sessions):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = SESSION_CACHE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(prune_sessions(sessions), f, indent=2, sort_keys=True)
        os.replace(tmp, SESSION_CACHE)
    except OSError as e:
        log(f"could not save session cache ({e})", "warning")


def installed_script_path():
    return os.path.realpath(globals().get("__file__") or sys.argv[0])


def validate_update_source(source):
    try:
        text = source.decode("utf-8")
    except UnicodeDecodeError as e:
        raise ValueError("downloaded update is not valid UTF-8") from e
    if not text.startswith("#!/usr/bin/env python3"):
        raise ValueError("downloaded update is not a hydra-rpc script")
    try:
        compile(text, UPDATE_URL, "exec")
    except SyntaxError as e:
        raise ValueError(f"downloaded update has invalid Python syntax: {e}") from e
    return source


def fetch_update_source():
    req = urllib.request.Request(UPDATE_URL, headers={"User-Agent": "hydra-rpc-updater/1.0"})
    with urllib.request.urlopen(req, timeout=UPDATE_TIMEOUT) as response:
        source = response.read()
    return validate_update_source(source)


def install_update(path, source):
    path = os.path.realpath(path)
    parent = os.path.dirname(path) or "."
    mode = os.stat(path).st_mode & 0o777 if os.path.exists(path) else 0o755
    fd, temporary = tempfile.mkstemp(prefix=".hydra-rpc-update-", dir=parent)
    try:
        with os.fdopen(fd, "wb") as output:
            output.write(source)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    except Exception:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def update_script(install=False):
    target = installed_script_path()
    try:
        with open(target, "rb") as current_file:
            current = current_file.read()
        latest = fetch_update_source()
    except (OSError, urllib.error.URLError, ValueError) as e:
        print(f"update failed: {e}", file=sys.stderr)
        return 1

    if current == latest:
        print("hydra-rpc is already up to date")
        return 0
    if not install:
        print(f"update available for {target}")
        print(f"latest source: {hashlib.sha256(latest).hexdigest()}")
        return 0

    try:
        install_update(target, latest)
    except OSError as e:
        print(f"update failed while replacing {target}: {e}", file=sys.stderr)
        return 1
    print(f"updated {target}; restart hydra-rpc to use the new version")
    return 0


def runtime_dir(cfg):
    d = cfg.get("socket_dir") or os.environ.get("XDG_RUNTIME_DIR")
    if d:
        return os.path.expanduser(os.path.expandvars(d))
    return f"/run/user/{os.getuid()}"


def encode_frame(msg_type, obj):
    data = json.dumps(obj).encode("utf-8")
    return struct.pack("<II", msg_type, len(data)) + data


def read_exact(sock, n):
    chunks = []
    got = 0
    while got < n:
        chunk = sock.recv(n - got)
        if not chunk:
            raise ConnectionError("socket closed")
        chunks.append(chunk)
        got += len(chunk)
    return b"".join(chunks)


def read_frame(sock, timeout):
    sock.settimeout(timeout)
    try:
        header = read_exact(sock, 8)
    except (socket.timeout, ConnectionError, OSError):
        return None
    msg_type, size = struct.unpack("<II", header)
    if size > MAX_IPC_FRAME_SIZE:
        raise ValueError(f"IPC frame too large: {size}")
    try:
        data = read_exact(sock, size)
    except (socket.timeout, ConnectionError, OSError):
        return None
    try:
        return msg_type, json.loads(data.decode("utf-8"))
    except Exception:
        return msg_type, None


class RPCClient:
    def __init__(self, base, socket_path="", max_socket_attempts=DEFAULT_SOCKET_ATTEMPTS):
        self.base = base
        socket_path = str(socket_path or "")
        self.socket_path = os.path.expanduser(os.path.expandvars(socket_path))
        self.max_socket_attempts = max(
            1, min(MAX_SOCKET_PATHS, int(max_socket_attempts))
        )
        self.path = None
        self.last_path = None
        self.sock = None
        self.client_id = None
        self.nonce = 0

    def _connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(SOCKET_CONNECT_TIMEOUT)
        try:
            s.connect(self.path)
            return s
        except OSError:
            s.close()
            raise

    def candidate_paths(self):
        if self.socket_path:
            return [self.socket_path]

        paths = []
        if self.last_path:
            paths.append(self.last_path)
        for i in range(self.max_socket_attempts):
            if len(paths) >= self.max_socket_attempts:
                break
            path = f"{self.base}-{i}"
            if path not in paths:
                paths.append(path)
        return paths

    def connect(self, client_id):
        if self.sock is not None:
            self.close()
        last_error = None
        for path in self.candidate_paths():
            self.path = path
            try:
                self.sock = self._connect()
                self.last_path = path
                break
            except OSError as e:
                last_error = e
                self.sock = None
        if self.sock is None:
            self.path = self.socket_path or None
            raise last_error or OSError(f"no arRPC socket found under {self.base}")
        self.sock.sendall(encode_frame(IPC_HANDSHAKE, {"v": 1, "client_id": client_id}))
        read_frame(self.sock, HANDSHAKE_READ_TIMEOUT)  # drain READY
        self.client_id = client_id

    def send(self, cmd, args):
        self.nonce += 1
        self.sock.sendall(
            encode_frame(IPC_FRAME, {"cmd": cmd, "args": args, "nonce": str(self.nonce)})
        )
        read_frame(self.sock, ACTIVITY_ACK_TIMEOUT)  # drain ack (content ignored)

    def ping(self):
        # Cheap liveness probe: a few bytes round-trip instead of a full
        # activity resend. Returns True only on a matching PONG echo,
        # False on timeout/closed socket. Lets protocol errors propagate.
        try:
            self.nonce += 1
            payload = {"nonce": str(self.nonce)}
            self.sock.sendall(encode_frame(IPC_PING, payload))
            reply = read_frame(self.sock, PING_PROBE_TIMEOUT)
        except OSError:
            return False
        return bool(reply) and reply[0] == IPC_PONG and reply[1] == payload

    def close(self):
        if self.sock is not None:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock = None
        self.client_id = None


from collections import OrderedDict

RESERVED_ACTIVITY_FIELDS = {"application_id", "name", "timestamps", "type"}

_ACTIVITY_CACHE = OrderedDict()
_ACTIVITY_CACHE_MAX = 512


def cached_activity(cache_key, make):
    try:
        activity = _ACTIVITY_CACHE.pop(cache_key)
    except KeyError:
        pass
    except TypeError:
        return make()
    else:
        # Return an independent copy so callers can never mutate the cached entry.
        _ACTIVITY_CACHE[cache_key] = activity
        return copy.deepcopy(activity)
    activity = make()
    while len(_ACTIVITY_CACHE) >= _ACTIVITY_CACHE_MAX:
        _ACTIVITY_CACHE.popitem(last=False)
    _ACTIVITY_CACHE[cache_key] = activity
    return copy.deepcopy(activity)


def rich_json(rich_activity):
    try:
        return json.dumps(rich_activity, sort_keys=True, default=str)
    except (TypeError, ValueError):
        return ""


def rich_fingerprint(cfg):
    # The rich-activity config is fixed for the life of the process, so
    # serialize it once instead of on every candidate, every poll.
    fingerprint = cfg.get("_rich_json")
    if fingerprint is None:
        fingerprint = rich_json(cfg["rich_activity"])
        try:
            cfg["_rich_json"] = fingerprint
        except TypeError:
            pass
    return fingerprint


class TemplateValues(dict):
    def __missing__(self, key):
        return "{" + key + "}"


def render_text(value, values):
    if not isinstance(value, str):
        return value
    try:
        return value.format_map(TemplateValues(values))
    except (KeyError, ValueError):
        return value


def render_activity_value(value, values):
    if isinstance(value, str):
        return render_text(value, values)
    if isinstance(value, list):
        return [render_activity_value(item, values) for item in value]
    if isinstance(value, dict):
        return {key: render_activity_value(item, values) for key, item in value.items()}
    return value


def resolve_game(exe, info, overrides, index, cfg):
    if isinstance(info, dict) and info.get("kind") == "emulator":
        return resolve_emulator_game(exe, info, cfg)

    app = overrides.get(exe) or index.get(exe)
    if not app:
        return None

    app_id, game_name = app
    game_name_key = game_name.casefold()
    if app_id in cfg["blocklist_ids"] or game_name_key in cfg["blocklist_names"]:
        return None

    if isinstance(info, dict):
        pid = info["pid"]
        if cfg["hydra_only"] and "hydra" not in info.get("sources", set()):
            return None
    else:
        pid = info
        if cfg["hydra_only"]:
            return None
    values = {
        "game_name": game_name,
        "exe": exe,
        "app_id": app_id,
    }
    template = cfg["activity_template"]
    cache_key = ("wine", exe, app_id, game_name, template, rich_fingerprint(cfg))

    def build():
        activity = {
            "application_id": app_id,
            "name": render_text(template, values),
        }
        rich_activity = render_activity_value(cfg["rich_activity"], values)
        for key, value in rich_activity.items():
            if key not in RESERVED_ACTIVITY_FIELDS:
                activity[key] = value
        return activity

    activity = cached_activity(cache_key, build)

    return {
        "exe": exe,
        "app_id": app_id,
        "game_name": game_name,
        "display_name": activity["name"],
        "pid": pid,
        "activity": activity,
    }


def emulator_override(exe, info, cfg):
    emulator = info["emulator"]
    rom_name = info["rom_name"].casefold()
    overrides = cfg["emulator_overrides"]
    return (
        overrides.get(f"{emulator}:{rom_name}")
        or overrides.get(exe.casefold())
    )


def emulator_application_id(exe, info, cfg):
    override = emulator_override(exe, info, cfg)
    return (override or {}).get("id") or cfg["emulator_application_ids"].get(
        info["emulator"], ""
    )


def resolve_emulator_game(exe, info, cfg):
    app_id = emulator_application_id(exe, info, cfg)
    if not app_id:
        return None

    game_name_key = info["rom_name"].casefold()
    if app_id in cfg["blocklist_ids"] or game_name_key in cfg["blocklist_names"]:
        return None

    if cfg["hydra_only"] and "hydra" not in info.get("sources", set()):
        return None

    emulator_name = DEFAULT_EMULATOR_NAMES[info["emulator"]]
    values = {
        "game_name": info["rom_name"],
        "rom_name": info["rom_name"],
        "emulator": info["emulator"],
        "emulator_name": emulator_name,
        "exe": exe,
        "app_id": app_id,
    }
    override_name = (emulator_override(exe, info, cfg) or {}).get("name")
    template = cfg["emulator_activity_template"]
    cache_key = (
        "emulator", exe, app_id, info["rom_name"], template,
        rich_fingerprint(cfg), override_name or "",
    )

    def build():
        activity = {
            "application_id": app_id,
            "name": override_name or render_text(template, values),
            "details": info["rom_name"],
        }
        rich_activity = render_activity_value(cfg["rich_activity"], values)
        for key, value in rich_activity.items():
            if key not in RESERVED_ACTIVITY_FIELDS:
                activity[key] = value
        return activity

    activity = cached_activity(cache_key, build)

    return {
        "exe": exe,
        "app_id": app_id,
        "game_name": info["rom_name"],
        "display_name": activity["name"],
        "pid": info["pid"],
        "activity": activity,
        "kind": "emulator",
        "emulator": info["emulator"],
        "rom_name": info["rom_name"],
        "rom_path": info["rom_path"],
    }


def choose_games(exes, active, overrides, index, cfg):
    ordered = [exe for exe in active if exe in exes]
    seen = set(ordered)
    ordered.extend(exe for exe in sorted(exes) if exe not in seen)
    games = []
    for exe in ordered:
        game = resolve_game(exe, exes[exe], overrides, index, cfg)
        if game:
            games.append(game)
            if cfg["max_activities"] and len(games) >= cfg["max_activities"]:
                break
    return games


def choose_game(exes, active, overrides, index):
    cfg = dict(DEFAULT_CONFIG)
    cfg["blocklist_ids"] = set()
    cfg["blocklist_names"] = set()
    cfg["rich_activity"] = {}
    game = choose_games(exes, [active] if active else [], overrides, index, cfg)
    if not game:
        return None
    selected = game[0]
    return selected["exe"], selected["app_id"], selected["display_name"], selected["pid"]


def activity_due(last_sent, now, interval):
    return last_sent is None or now - last_sent >= interval


def retry_delay(failures):
    if failures <= 0:
        return 0
    return min(RETRY_MAX_SECONDS, RETRY_INITIAL_SECONDS * 2 ** (failures - 1))


def should_send_activity(last_payload, payload, refresh_unchanged):
    # The periodic refresh doubles as a connection-liveness probe, so it stays
    # on by default; disabling it skips IPC traffic for byte-identical payloads.
    if refresh_unchanged:
        return True
    return last_payload is None or last_payload != payload


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        description="Report Wine/Proton and emulator games to Discord through arRPC."
    )
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument(
        "--dry-run",
        action="store_true",
        help="detect and log games without sending Discord activity",
    )
    modes.add_argument(
        "--validate-config",
        action="store_true",
        help="validate settings, load the game database, and check arRPC",
    )
    modes.add_argument(
        "--check-update",
        action="store_true",
        help="check GitHub for a newer hydra-rpc script",
    )
    modes.add_argument(
        "--update",
        action="store_true",
        help="download and atomically install the latest GitHub script",
    )
    return parser.parse_args(argv)


def validate_config(cfg, index):
    base = runtime_dir(cfg) + "/discord-ipc"
    client = RPCClient(
        base,
        cfg.get("socket_path", ""),
        cfg["max_socket_attempts"],
    )
    for path in client.candidate_paths():
        client.path = path
        try:
            probe = client._connect()
            probe.close()
            log(f"config valid; loaded {len(index)} executable mappings")
            log(f"arRPC socket ready: {path}")
            return True
        except OSError:
            continue
    log(
        f"config valid; loaded {len(index)} executable mappings, "
        "but no arRPC socket was found",
        "warning",
    )
    return False


def close_state(state):
    client = state["client"]
    if client.sock is not None:
        try:
            client.send("SET_ACTIVITY", {"activity": None, "pid": 0})
        except OSError:
            pass
    client.close()


def get_process_start_tick(pid):
    try:
        with open(f"/proc/{pid}/stat", "r") as stat_file:
            stat = stat_file.read()
        fields = stat.rsplit(")", 1)[1].split()
        return int(fields[19])
    except (OSError, ValueError, IndexError):
        return None


def session_start(sessions, game):
    record = sessions.get(game["exe"])
    now_ms = int(time.time() * 1000)
    current_tick = get_process_start_tick(game["pid"])
    if isinstance(record, dict):
        try:
            start_ms = int(record["start_ms"])
            start_tick = int(record["start_tick"])
            if (
                current_tick is not None
                and int(record["pid"]) == game["pid"]
                and start_tick == current_tick
                and 0 < start_ms <= now_ms
            ):
                return start_ms
        except (KeyError, TypeError, ValueError):
            pass
    return now_ms


def _decode_parts(raw_parts):
    return [item.decode("utf-8", "ignore").strip() for item in raw_parts if item]


_ENVIRON_CHUNK_BYTES = 65536

_MARKER_BYTES_CACHE = {}
_MARKER_BYTES_CACHE_MAX = 64


def _marker_bytes(markers):
    # Marker sets are fixed per run, so encode them once instead of per process.
    key = frozenset(markers)
    cached = _MARKER_BYTES_CACHE.get(key)
    if cached is None:
        cached = tuple(m.encode("utf-8", "ignore").lower() for m in markers if m)
        if len(_MARKER_BYTES_CACHE) >= _MARKER_BYTES_CACHE_MAX:
            _MARKER_BYTES_CACHE.clear()
        _MARKER_BYTES_CACHE[key] = cached
    return cached


def _contains_any(blob, needles):
    return any(needle in blob for needle in needles)


def has_hydra_marker(pid, raw_parts, markers, stats=None):
    byte_markers = _marker_bytes(markers)
    if not byte_markers:
        return False
    if _contains_any(b"\0".join(p for p in raw_parts if p).lower(), byte_markers):
        return True
    # Stream the environment in chunks instead of loading/decoding it whole.
    # Keep an overlap so a marker split across a chunk boundary is still found.
    overlap = max(len(marker) for marker in byte_markers)
    try:
        with open(f"/proc/{pid}/environ", "rb") as environment_file:
            if stats is not None:
                stats["environ_reads"] = stats.get("environ_reads", 0) + 1
            tail = b""
            while True:
                chunk = environment_file.read(_ENVIRON_CHUNK_BYTES)
                if not chunk:
                    return False
                if _contains_any((tail + chunk).lower(), byte_markers):
                    return True
                tail = chunk[-(overlap - 1):] if overlap > 1 else b""
    except OSError:
        return False


def _iter_cmdlines(stats=None):
    try:
        pids = os.listdir("/proc")
    except OSError:
        return
    for pid in pids:
        if not pid.isdigit():
            continue
        if stats is not None:
            stats["processes"] = stats.get("processes", 0) + 1
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                raw = f.read()
        except OSError:
            continue
        if not raw:
            continue
        if stats is not None:
            stats["cmdlines"] = stats.get("cmdlines", 0) + 1
        yield int(pid), raw


def scan_processes(blocklist, hydra_markers=None, emulators_enabled=False, mark_hydra=True, stats=None):
    markers = set(hydra_markers or DEFAULT_HYDRA_MARKERS)
    found = {}
    for pid, raw in _iter_cmdlines(stats):
        parts = raw.split(b"\0")
        decoded = None
        hydra_state = None

        for part in parts:
            piece = part.rstrip()
            if len(piece) < 4 or piece[-4:].lower() != b".exe":
                continue
            if mark_hydra and hydra_state is None:
                hydra_state = has_hydra_marker(pid, parts, markers, stats)
            arg = piece.decode("utf-8", "ignore")
            base = arg.replace("\\", "/").rsplit("/", 1)[-1].lower()
            if not base or base in blocklist:
                continue
            info = found.setdefault(
                base,
                {"pid": pid, "path": arg, "sources": set()},
            )
            if hydra_state:
                info["sources"].add("hydra")

        if not emulators_enabled:
            continue
        # Fast path: only decode/scan processes whose executable looks like a
        # known emulator (or a flatpak/bwrap wrapper, which needs a full scan).
        first = parts[0].decode("utf-8", "ignore").strip() if parts and parts[0] else ""
        base0 = first.replace("\\", "/").rsplit("/", 1)[-1].lower()
        profile = _EMULATOR_BINARY_MAP.get(base0)
        if profile is None:
            for token, candidate in _EMULATOR_BINARY_MAP.items():
                if token in base0:
                    profile = candidate
                    break
        if profile is None and base0 not in ("flatpak", "bwrap"):
            continue
        if decoded is None:
            decoded = _decode_parts(parts)
        text = " ".join(decoded).casefold()
        profiles = (profile,) if profile is not None else tuple(EMULATOR_PROFILES)
        if stats is not None:
            stats["emulator_candidates"] = stats.get("emulator_candidates", 0) + 1
        for profile in profiles:
            settings = EMULATOR_PROFILES[profile]
            if not any(pattern in text for pattern in settings["patterns"]):
                continue
            rom_path = extract_emulator_rom(profile, decoded)
            if not rom_path:
                continue
            if mark_hydra and hydra_state is None:
                hydra_state = has_hydra_marker(pid, parts, markers, stats)
            key = f"emulator:{profile}:{rom_path.casefold()}"
            info = found.setdefault(
                key,
                {
                    "kind": "emulator",
                    "emulator": profile,
                    "rom_path": rom_path,
                    "rom_name": clean_rom_name(profile, rom_path),
                    "pid": pid,
                    "path": rom_path,
                    "sources": set(),
                },
            )
            if hydra_state:
                info["sources"].add("hydra")
    if stats is not None:
        stats["wine_hits"] = sum(1 for v in found.values() if v.get("kind") != "emulator")
        stats["emulator_hits"] = sum(1 for v in found.values() if v.get("kind") == "emulator")
    return found


def normalise_argument(value):
    return value.strip().strip('"').strip("'").replace("\\", "/")


def extract_emulator_rom(profile, parts):
    extensions = EMULATOR_PROFILES[profile]["extensions"]
    for value in reversed(parts[1:]):
        path = normalise_argument(value)
        if not path or path.startswith("-"):
            continue
        upper = path.upper()
        if profile == "rpcs3" and (
            upper.endswith("/EBOOT.BIN")
            or "/PS3_GAME/" in upper
            or "/DEV_HDD0/GAME/" in upper
        ):
            return path
        extension = os.path.splitext(path)[1].casefold()
        if extension in extensions:
            return path
    return None


def clean_rom_name(profile, rom_path):
    path = normalise_argument(rom_path).rstrip("/")
    upper = path.upper()
    marker = "/PS3_GAME/"
    if profile == "rpcs3" and marker in upper:
        path = path[:upper.index(marker)].rstrip("/")
    name = os.path.basename(path) or DEFAULT_EMULATOR_NAMES[profile]
    stem, extension = os.path.splitext(name)
    if extension:
        name = stem
    name = name.replace("_", " ").strip()
    return name[:128] or DEFAULT_EMULATOR_NAMES[profile]


def detect_emulators(hydra_markers=None):
    found = scan_processes(set(), hydra_markers, emulators_enabled=True)
    return {key: info for key, info in found.items() if info.get("kind") == "emulator"}


def detect_exes(blocklist, hydra_markers=None):
    found = scan_processes(blocklist, hydra_markers)
    return {key: info for key, info in found.items() if info.get("kind") != "emulator"}


def main(argv=None):
    args = parse_args(argv)
    if args.check_update:
        return update_script()
    if args.update:
        return update_script(install=True)
    cfg = load_config()
    configure_logging(cfg)
    ensure_config(cfg)
    index = load_db(cfg)
    if not index:
        log("no detectable database available; games will need overrides", "error")
    log(f"loaded {len(index)} executable mappings")

    if args.validate_config:
        valid = validate_config(cfg, index)
        close_logging()
        return 0 if valid else 1

    sessions = load_sessions()
    base = runtime_dir(cfg) + "/discord-ipc"
    states = {}
    sessions_dirty = False
    dry_signature = None
    seen_unknown = set()

    def stop(*_args):
        log("shutting down")
        for state in states.values():
            close_state(state)
        save_sessions(sessions)
        close_logging()
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    # Deadline-based scheduling: scans that overrun (e.g. slow IPC) shift the
    # next deadline instead of stacking sleeps, so delays can't accumulate.
    next_scan = 0.0
    while True:
        try:
            now = time.monotonic()
            if now < next_scan:
                time.sleep(next_scan - now)
            scan_start = time.monotonic()
            stats = {}
            exes = scan_processes(
                cfg["blocklist"],
                cfg["hydra_markers"],
                cfg["emulators_enabled"],
                cfg["hydra_only"],
                stats,
            )
            scan_ms = (time.monotonic() - scan_start) * 1000
            log(
                f"scan: {stats.get('processes', 0)} procs, "
                f"{stats.get('cmdlines', 0)} cmdlines, "
                f"{stats.get('environ_reads', 0)} environs, "
                f"{stats.get('emulator_candidates', 0)} emu candidates, "
                f"{stats.get('wine_hits', 0)} wine + "
                f"{stats.get('emulator_hits', 0)} emu hits "
                f"in {scan_ms:.1f}ms",
                "debug",
            )

            for exe in sorted(exes):
                info = exes[exe]
                if isinstance(info, dict) and info.get("kind") == "emulator":
                    configured = bool(emulator_application_id(exe, info, cfg))
                    message = (
                        f"emulator '{info['emulator']}' detected '{info['rom_name']}' "
                        f"but has no Discord application ID; configure "
                        f"emulator_application_ids.{info['emulator']}"
                    )
                else:
                    configured = bool(cfg["overrides"].get(exe) or index.get(exe))
                    message = f"unrecognized executable '{exe}' (add an override in {CONFIG_PATH})"
                if not configured and exe not in seen_unknown:
                    seen_unknown.add(exe)
                    log(message, "warning")

            games = choose_games(exes, states.keys(), cfg["overrides"], index, cfg)

            if args.dry_run:
                signature = tuple(
                    (game["exe"], game["display_name"])
                    for game in games
                )
                if signature != dry_signature:
                    if games:
                        for game in games:
                            log(
                                f"dry-run: detected game: {game['display_name']} "
                                f"({game['exe']}) (would report)"
                            )
                    else:
                        log("dry-run: no supported games detected")
                    dry_signature = signature
                next_scan = scan_start + cfg["poll_seconds"]
                continue

            selected = {game["exe"]: game for game in games}
            for exe in list(states):
                if exe not in selected:
                    log(f"game exited: {states[exe]['display_name']}; clearing presence")
                    close_state(states.pop(exe))
                    if sessions.pop(exe, None) is not None:
                        sessions_dirty = True

            for exe, game in selected.items():
                state = states.get(exe)
                if state is None:
                    start_ms = session_start(sessions, game)
                    previous_session = sessions.get(exe)
                    sessions[exe] = {
                        "start_ms": start_ms,
                        "pid": game["pid"],
                        "start_tick": get_process_start_tick(game["pid"]),
                    }
                    sessions_dirty |= previous_session != sessions[exe]
                    state = {
                        **game,
                        "start_ms": start_ms,
                        "client": RPCClient(
                            base,
                            cfg.get("socket_path", ""),
                            cfg["max_socket_attempts"],
                        ),
                        "last_activity_sent": None,
                        "last_activity_payload": None,
                        "connection_failures": 0,
                        "next_connection_attempt": 0.0,
                    }
                    states[exe] = state
                    log(
                        f"detected game: {game['display_name']} ({exe}) "
                        f"app_id={game['app_id']}"
                    )
                else:
                    metadata_changed = any(
                        state[key] != game[key]
                        for key in ("app_id", "display_name", "activity")
                    )
                    state.update(game)
                    if metadata_changed:
                        state["client"].close()
                        state["last_activity_sent"] = None
                        state["last_activity_payload"] = None
                        state["connection_failures"] = 0
                        state["next_connection_attempt"] = 0.0

                now = time.monotonic()
                if state["client"].sock is None:
                    if now < state["next_connection_attempt"]:
                        continue
                    try:
                        state["client"].connect(state["app_id"])
                    except OSError as e:
                        state["connection_failures"] += 1
                        delay = retry_delay(state["connection_failures"])
                        state["next_connection_attempt"] = time.monotonic() + delay
                        target = state["client"].path or f"{base}-0..{cfg['max_socket_attempts'] - 1}"
                        log(
                            f"could not connect to arRPC at {target} ({e}); "
                            f"retrying in {delay}s",
                            "warning",
                        )
                        continue
                    state["connection_failures"] = 0
                    state["next_connection_attempt"] = 0.0
                    state["last_activity_sent"] = None
                    state["last_activity_payload"] = None

                now = time.monotonic()
                if activity_due(
                    state["last_activity_sent"],
                    now,
                    cfg["activity_refresh_seconds"],
                ):
                    activity = dict(state["activity"])
                    activity["timestamps"] = {"start": state["start_ms"]}
                    if not should_send_activity(
                        state.get("last_activity_payload"),
                        activity,
                        cfg["refresh_unchanged_activities"],
                    ):
                        # Payload unchanged and periodic resends disabled:
                        # verify the connection is still alive with a tiny
                        # ping instead of a full activity resend.
                        if state["client"].ping():
                            state["last_activity_sent"] = now
                        else:
                            log("arRPC connection lost, will reconnect", "warning")
                            state["client"].close()
                            state["last_activity_payload"] = None
                            state["connection_failures"] += 1
                            delay = retry_delay(state["connection_failures"])
                            state["next_connection_attempt"] = time.monotonic() + delay
                    else:
                        try:
                            state["client"].send(
                                "SET_ACTIVITY",
                                {"activity": activity, "pid": state["pid"]},
                            )
                            state["last_activity_sent"] = now
                            state["last_activity_payload"] = activity
                        except OSError:
                            log("arRPC connection lost, will reconnect", "warning")
                            state["client"].close()
                            state["connection_failures"] += 1
                            delay = retry_delay(state["connection_failures"])
                            state["next_connection_attempt"] = time.monotonic() + delay

            if sessions_dirty:
                save_sessions(sessions)
                sessions_dirty = False
            next_scan = scan_start + cfg["poll_seconds"]

        except Exception as e:
            log(f"unexpected error: {e}", "error")
            next_scan = time.monotonic() + cfg["poll_seconds"]


if __name__ == "__main__":
    raise SystemExit(main())
